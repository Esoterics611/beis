# ── Firebase Client SDK ─────────────────────────────────────────
# Get these from: Firebase Console → Your project → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin SDK ──────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Auth bootstrap ──────────────────────────────────────────────
# Comma-separated emails that get the admin role on first sign-in
ADMIN_EMAILS=
# Optional: wallet address that gets the admin role via wallet sign-in (legacy dev path)
BOOTSTRAP_ADMIN_WALLET=

# ── Base Sepolia ────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=

# ── Contract addresses (Base Sepolia) ──────────────────────────
VITE_SECHAR_TOKEN_ADDRESS=
VITE_BEIS_REGISTRY_ADDRESS=
VITE_CHIBBUR_REWARDS_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_GOVERNANCE_ADDRESS=
VITE_GOVERNANCE_TREASURY_ADDRESS=
VITE_CHIBBUR_REWARDS_V2_ADDRESS=
ATTESTATION_SIGNER_PRIVATE_KEY=

# ── Donation Rail ───────────────────────────────────────────────
DONATION_TRACKING_WALLET=
