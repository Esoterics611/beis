rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOfficer() {
      return request.auth.token.tier == 'officer';
    }
    function isNcoOrAbove() {
      return request.auth.token.tier in ['nco', 'officer'];
    }
    function isSelf(walletAddress) {
      return request.auth.uid == 'wallet_' + walletAddress;
    }

    // ── Nonces — public write, server deletes ─────────────────
    match /nonces/{address} {
      allow create: if true;
      allow read:   if true;
      allow delete: if true; // cleaned up server-side via Admin SDK
      allow update: if false;
    }

    // ── Mekomot — read-only for authenticated ─────────────────
    match /mekomot/{id} {
      allow read:  if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ── Talmidim ──────────────────────────────────────────────
    match /talmidim/{talmidId} {
      allow read:  if isAuthenticated();
      // Writes come through API routes (Admin SDK) only
      allow write: if false;
    }

    // ── Mivtzaot ──────────────────────────────────────────────
    match /mivtzaot/{mivtzaId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Masimot ───────────────────────────────────────────────
    match /masimot/{masimaId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Tafkidim ──────────────────────────────────────────────
    match /tafkidim/{tafkidId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Peer Reviews ──────────────────────────────────────────
    match /peerReviews/{reviewId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Discussions ───────────────────────────────────────────
    match /discussions/{discussionId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Treasury ──────────────────────────────────────────────
    match /treasury/{docId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Activities ────────────────────────────────────────────
    match /activities/{activityId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Donations ─────────────────────────────────────────────
    match /donations/{donationId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Proposals ──────────────────────────────────────────────
    match /proposals/{proposalId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Payment Streams ────────────────────────────────────────
    match /paymentStreams/{streamId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }
  }
}
